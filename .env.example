# =============================================================================
#  Configuration — Auto Veille n8n IA Local
# =============================================================================
#  Copiez ce fichier en « .env » puis remplacez les valeurs.
#      cp .env.example .env
#  Le fichier .env NE DOIT JAMAIS être commité (il est déjà dans .gitignore).
# =============================================================================

# --- Base de données PostgreSQL ---------------------------------------------
DB_USER=veille
DB_PASSWORD=changez-ce-mot-de-passe
DB_NAME=n8n_db

# --- Fuseau horaire (n8n / planification des workflows) ----------------------
TZ=Europe/Paris

# --- Clé secrète de l'interface Flask ----------------------------------------
# Générez une valeur aléatoire, par ex. :  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=changez-cette-cle-secrete

# --- Clé secrète SearXNG -----------------------------------------------------
# Générez une valeur aléatoire, par ex. :  openssl rand -hex 32
SEARXNG_SECRET=changez-cette-cle-searxng
